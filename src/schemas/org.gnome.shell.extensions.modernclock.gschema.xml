<schemalist gettext-domain='modernclock@gnome-port'>
    <enum id='org.gnome.shell.extensions.modernclock.date-format'>
        <value value='0' nick='numeric' />
        <value value='1' nick='short' />
        <value value='2' nick='text' />
    </enum>
    <enum id='org.gnome.shell.extensions.modernclock.time-format'>
        <value value='0' nick='24h' />
        <value value='1' nick='ampm' />
    </enum>
    <schema id='org.gnome.shell.extensions.modernclock' path='/org/gnome/shell/extensions/modernclock/'>
        <key name='position-x' type='d'>
            <default>0.5</default>
            <range min='0' max='1'/>
            <summary>Horizontal position</summary>
            <description>Horizontal position of the widget on the desktop.</description>
        </key>
        <key name='position-y' type='d'>
            <default>0.5</default>
            <range min='0' max='1'/>
            <summary>Vertical position</summary>
            <description>Vertical position of the widget on the desktop.</description>
        </key>
        <key name='scale' type='d'>
            <default>0.5</default>
            <range min='0' max='1'/>
            <summary>Widget size</summary>
            <description>Overall size scale of the widget.</description>
        </key>
        <key name='use-english' type='b'>
            <default>false</default>
            <summary>Use English</summary>
            <description>Use English for the date instead of the system language.</description>
        </key>
        <key name='date-format' enum='org.gnome.shell.extensions.modernclock.date-format'>
            <default>'short'</default>
            <summary>Date format</summary>
            <description>numeric: '01.09.2026', short: '01 SEP 2026', text: '01 SEPTEMBER 2026'</description>
        </key>
        <key name='date-deco' type='s'>
            <default>''</default>
            <summary>Date decoration</summary>
            <description>Characters around the date.</description>
        </key>
        <key name='time-format' enum='org.gnome.shell.extensions.modernclock.time-format'>
            <default>'ampm'</default>
            <summary>Time format</summary>
            <description>24-hour or AM/PM.</description>
        </key>
        <key name='time-deco' type='s'>
            <default>'-'</default>
            <summary>Time decoration</summary>
            <description>Characters around the time.</description>
        </key>
    </schema>
</schemalist>
